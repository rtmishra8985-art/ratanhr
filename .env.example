# ─────────────────────────────────────────────────────────────────────────────
# HRMS — environment template
#
# Copy to .env and fill in, or generate the secret values automatically with:
#   ./scripts/generate-secrets.sh
# NEVER commit the real .env (it is listed in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (MySQL 8.4) ─────────────────────────────────────────────────────
MYSQL_DATABASE=hrms_db
MYSQL_USER=hrms
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=hrms_db;User ID=hrms;Password=;AllowPublicKeyRetrieval=True;SslMode=Required

# ── JWT RS256 key pair (PEM, newlines escaped as \n) ─────────────────────────
# These names are consumed directly by docker-compose.yml and the API startup
# validator. Keep the .NET configuration aliases below for local appsettings
# binding compatibility.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
Jwt__PrivateKeyPem=
Jwt__PublicKeyPem=

# ── PII encryption (AES-256, base64) ─────────────────────────────────────────
ENCRYPTION_KEY=
Security__EncryptionKey=

# ── Redis / Hangfire storage ─────────────────────────────────────────────────
REDIS_PASSWORD=
REDIS_CONNECTION_STRING=redis:6379,password=,ssl=False,abortConnect=False
Redis__ConnectionString=redis:6379,password=,ssl=False,abortConnect=False
Hangfire__UseRedis=true
Hangfire__UseInMemory=false
Hangfire__RedisConnectionString=redis:6379,password=,ssl=False,abortConnect=False

# ── Domain & nginx ───────────────────────────────────────────────────────────
DOMAIN_NAME=yourdomain.com
API_URL=https://yourdomain.com/api
APP_ENV=production
SSL_CERT_PATH=/etc/letsencrypt/live/yourdomain.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/yourdomain.com/privkey.pem

# ── .NET host filtering (both spellings are read; keep them identical) ───────
AllowedHosts=yourdomain.com
ALLOWED_HOSTS=yourdomain.com

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://yourdomain.com

# ── OpenTelemetry ────────────────────────────────────────────────────────────
# Metrics: always collected; Prometheus scrapes GET /metrics on the api service.
# Traces:  exported over OTLP to the bundled jaeger service (UI: localhost:16686).
#          Set OTEL_OTLP_ENDPOINT= (empty) to turn trace export off.
OTEL_OTLP_ENDPOINT=http://jaeger:4317
OTEL_OTLP_PROTOCOL=grpc
OTEL_EXPORT_METRICS_VIA_OTLP=false

# ── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── Backup encryption ────────────────────────────────────────────────────────
BACKUP_ENCRYPTION_KEY=
BACKUP_RETAIN_DAYS=14
BACKUP_CRON_SCHEDULE=0 2 * * *

# ── Optional off-site backup profile ─────────────────────────────────────────
# Required only when starting docker-compose.backup.yml or the offsite profile.
S3_BUCKET=
S3_PREFIX=hrms/mysql
S3_RETAIN_DAYS=90
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_ENDPOINT_URL=

# ── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_SSL=false
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM_ADDRESS=noreply@yourdomain.com
EMAIL_FROM_NAME=HRMS System
Email__Host=
Email__Port=587
Email__UseSsl=false
Email__Username=
Email__Password=
Email__FromAddress=noreply@yourdomain.com
Email__FromName=HRMS System

# ── Compliance ───────────────────────────────────────────────────────────────
DPO_EMAIL=
COMPLIANCE_REGIME=dpdp

# ── Staging / E2E overrides ──────────────────────────────────────────────────
STAGING_DB_NAME=hrms_staging
STAGING_DB_USER=hrms_staging
STAGING_DB_PASSWORD=
STAGING_DB_ROOT_PASSWORD=
STAGING_REDIS_PASSWORD=
COMPLIANCE_DPO_EMAIL=dpo@hrms-staging.local
