{
  // appsettings.Production.json — RatanHR HRMS
  //
  // AllowedHosts is intentionally LEFT EMPTY here.
  // The actual value MUST be supplied via the ALLOWED_HOSTS environment variable,
  // which is picked up by ServiceExtensions.AddAllowedHostsFromEnvironment().
  // EnvironmentValidator.Validate() rejects startup if the variable is missing,
  // empty, a wildcard (*), or contains placeholder/example values.
  //
  // Keeping this file free of a committed wildcard prevents the classic
  // "works in dev, broken in prod" host-filtering misconfiguration.
  "AllowedHosts": "",

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "Hangfire": "Warning"
    }
  },

  "Database": {
    // Never set AutoMigrate=true in Production.
    // Migrations are applied by the dedicated `migrate` Docker service
    // before the API container starts.
    "AutoMigrate": false
  },

  "Hangfire": {
    // UseRedis MUST remain true; EnvironmentValidator rejects false outside Development.
    "UseRedis": true
    // RedisConnectionString is injected via the REDIS_CONNECTION_STRING / Hangfire__RedisConnectionString
    // environment variable from docker-compose.prod.yml — never committed here.
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "Hangfire": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/hrms-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 104857600,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
