# =============================================================
# Alertmanager Configuration — HRMS Monitoring Stack
# FIX 10: Alertmanager is now active in docker-compose.yml.
#
# This file configures where Prometheus alert notifications are routed.
# No credentials are stored here — inject via environment variables
# in docker-compose.yml or via Docker secrets.
#
# Documentation: https://prometheus.io/docs/alerting/latest/configuration/
# =============================================================

global:
  # How long to wait before re-sending a previously sent alert.
  resolve_timeout: 5m
  # SMTP settings — set via env vars in docker-compose:
  #   ALERTMANAGER_SMTP_FROM, ALERTMANAGER_SMTP_SMARTHOST, etc.
  smtp_from:       "${ALERTMANAGER_SMTP_FROM}"
  smtp_smarthost:  "${ALERTMANAGER_SMTP_SMARTHOST}"
  smtp_auth_username: "${ALERTMANAGER_SMTP_USERNAME}"
  smtp_auth_password: "${ALERTMANAGER_SMTP_PASSWORD}"
  smtp_require_tls: true

# Route tree — alerts cascade down until a matching route is found.
route:
  # Default receiver for all alerts (can be overridden per sub-route).
  receiver: default-receiver

  # How long to wait to group initial batch of alerts before sending.
  group_wait: 30s
  # How long to wait before sending a notification about new alerts
  # added to a group that has already been notified about.
  group_interval: 5m
  # How long to wait before sending a repeated notification for an
  # alert that is still firing.
  repeat_interval: 4h

  # Group alerts by these labels so related fires are batched.
  group_by: [alertname, environment, service]

  # Route critical alerts to a separate receiver with shorter intervals.
  routes:
    - match:
        severity: critical
      receiver: critical-receiver
      group_wait:      10s
      repeat_interval: 1h

    - match:
        severity: warning
      receiver: default-receiver
      repeat_interval: 4h

# Receivers define where alert notifications are sent.
receivers:
  # ── Default receiver ────────────────────────────────────────────────────────
  # FIX-ALERTMANAGER-01: Removed noop webhook placeholder that would fail
  # on every alert. Default receiver now uses email when ALERTMANAGER_EMAIL_TO
  # is set. Uncomment Slack or PagerDuty blocks and set env vars as needed.
  # Supply receiver env vars in docker-compose.yml environment section for
  # the alertmanager service.
  - name: default-receiver
    # ── Email ────────────────────────────────────────────────────────────────
    # Set ALERTMANAGER_EMAIL_TO in your .env / docker-compose environment.
    # Example: ALERTMANAGER_EMAIL_TO=ops@yourcompany.com
    email_configs:
      - to: "${ALERTMANAGER_EMAIL_TO}"
        send_resolved: true
        headers:
          Subject: '[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ .Alerts.Firing | len }}{{ end }}] HRMS Alert — {{ .GroupLabels.alertname }}'

    # ── Slack (uncomment and set ALERTMANAGER_SLACK_WEBHOOK_URL to enable) ───
    # slack_configs:
    #   - api_url: "${ALERTMANAGER_SLACK_WEBHOOK_URL}"
    #     channel:  "#hrms-alerts"
    #     title:    '{{ template "slack.default.title" . }}'
    #     text:     '{{ template "slack.default.text" . }}'
    #     send_resolved: true

    # ── PagerDuty (uncomment and set ALERTMANAGER_PAGERDUTY_ROUTING_KEY) ─────
    # pagerduty_configs:
    #   - routing_key: "${ALERTMANAGER_PAGERDUTY_ROUTING_KEY}"
    #     severity:     '{{ .GroupLabels.severity }}'
    #     send_resolved: true

  # ── Critical receiver (higher urgency) ──────────────────────────────────────
  - name: critical-receiver
    # For critical alerts, set ALERTMANAGER_ONCALL_EMAIL in docker-compose env.
    email_configs:
      - to: "${ALERTMANAGER_ONCALL_EMAIL}"
        send_resolved: true
        headers:
          Subject: '[CRITICAL] HRMS Alert — {{ .GroupLabels.alertname }}'
    # slack_configs:
    #   - api_url: "${ALERTMANAGER_SLACK_WEBHOOK_URL}"
    #     channel:  "#hrms-critical"
    #     send_resolved: true

# ── Inhibition rules ────────────────────────────────────────────────────────
# Suppress warning-level alerts when a critical alert for the same
# service is already firing — avoids alert fatigue.
inhibit_rules:
  - source_match:
      severity: critical
    target_match:
      severity: warning
    equal: [alertname, environment, service]
