    #region MULTI-TENANCY TESTS

    [Fact]
    public async Task MultiTenancy_DocumentTemplateScoped()
    {
        // Arrange
        var template1 = new DocumentTemplate
        {
            CompanyId = 1,
            Name = "Company 1 Template",
            TemplateContent = "Content 1",
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        };

        var template2 = new DocumentTemplate
        {
            CompanyId = 2,
            Name = "Company 2 Template",
            TemplateContent = "Content 2",
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        };

        // Act
        _context.DocumentTemplates.Add(template1);
        _context.DocumentTemplates.Add(template2);
        await _context.SaveChangesAsync();

        var company1Templates = await _context.DocumentTemplates
            .Where(x => x.CompanyId == 1)
            .ToListAsync();

        var company2Templates = await _context.DocumentTemplates
            .Where(x => x.CompanyId == 2)
            .ToListAsync();

        // Assert
        Assert.Single(company1Templates);
        Assert.Single(company2Templates);
        Assert.NotEqual(company1Templates[0].Id, company2Templates[0].Id);
    }

    #endregion

    #region INDEX & PERFORMANCE TESTS

    [Fact]
    public async Task Indexes_CanQueryByCompanyAndStatus()
    {
        // Arrange - Create multiple assignments with different statuses
        var assignments = new[]
        {
            new ProjectAssignment
            {
                CompanyId = 1,
                ProjectName = "Project 1",
                AssignedEmployeeId = "EMP001",
                Status = "InProgress",
                StartDate = DateTime.UtcNow,
                CreatedAt = DateTime.UtcNow
            },
            new ProjectAssignment
            {
                CompanyId = 1,
                ProjectName = "Project 2",
                AssignedEmployeeId = "EMP002",
                Status = "Completed",
                StartDate = DateTime.UtcNow,
                CreatedAt = DateTime.UtcNow
            },
            new ProjectAssignment
            {
                CompanyId = 2,
                ProjectName = "Project 3",
                AssignedEmployeeId = "EMP003",
                Status = "InProgress",
                StartDate = DateTime.UtcNow,
                CreatedAt = DateTime.UtcNow
            }
        };

        // Act
        foreach (var assignment in assignments)
            _context.ProjectAssignments.Add(assignment);
        await _context.SaveChangesAsync();

        // Query using indexed columns
        var company1InProgress = await _context.ProjectAssignments
            .Where(x => x.CompanyId == 1 && x.Status == "InProgress")
            .ToListAsync();

        // Assert
        Assert.Single(company1InProgress);
        Assert.Equal("Project 1", company1InProgress[0].ProjectName);
    }

    #endregion

    #region RELATIONSHIPS & FK TESTS

    [Fact]
    public async Task ForeignKey_ComplianceEvidenceToChecklist()
    {
        // Arrange
        var checklist = new ComplianceChecklist
        {
            CompanyId = 1,
            Name = "Test Checklist",
            ChecklistItems = "[]",
            IsActive = true,
            CreatedAt = DateTime.UtcNow
        };

        _context.ComplianceChecklists.Add(checklist);
        await _context.SaveChangesAsync();

        var evidence = new ComplianceEvidence
        {
            CompanyId = 1,
            ComplianceChecklistId = checklist.Id,
            Status = "Completed",
            CreatedAt = DateTime.UtcNow
        };

        _context.ComplianceEvidences.Add(evidence);
        await _context.SaveChangesAsync();

        // Act - Load with navigation
        var loaded = await _context.ComplianceEvidences
            .Include(x => x.Checklist)
            .FirstAsync();

        // Assert
        Assert.NotNull(loaded.Checklist);
        Assert.Equal(checklist.Id, loaded.Checklist.Id);
    }

    #endregion
}
