    #endregion

    #region LOW PRIORITY TESTS

    [Fact]
    public async Task ApiAuditLog_CanLogRequests()
    {
        // Arrange
        var log = new ApiAuditLog
        {
            CompanyId = 1,
            UserId = "user123",
            Endpoint = "/api/employees",
            Method = "GET",
            StatusCode = 200,
            RequestBody = "{\"page\":1}",
            ResponseBody = "{\"data\":[...]}",
            IpAddress = "192.168.1.1",
            UserAgent = "Mozilla/5.0",
            DurationMs = 145,
            OccurredAt = DateTime.UtcNow
        };

        // Act
        _context.ApiAuditLogs.Add(log);
        await _context.SaveChangesAsync();

        var retrieved = await _context.ApiAuditLogs
            .FirstOrDefaultAsync(x => x.Endpoint == "/api/employees");

        // Assert
        Assert.NotNull(retrieved);
        Assert.Equal(200, retrieved.StatusCode);
        Assert.Equal("GET", retrieved.Method);
        Assert.Equal(145, retrieved.DurationMs);
    }

    [Fact]
    public async Task SystemSetting_CanStoreGlobalAndCompanySetting()
    {
        // Arrange - Global Setting
        var globalSetting = new SystemSetting
        {
            CompanyId = null, // Global
            SettingKey = "default_currency",
            SettingValue = "USD",
            SettingType = "String",
            Description = "Default currency for reports",
            IsEncrypted = false,
            CreatedAt = DateTime.UtcNow
        };

        // Arrange - Company Setting
        var companySetting = new SystemSetting
        {
            CompanyId = 1,
            SettingKey = "work_hours_per_day",
            SettingValue = "8",
            SettingType = "Int",
            Description = "Standard work hours per day",
            IsEncrypted = false,
            CreatedAt = DateTime.UtcNow
        };

        // Act
        _context.SystemSettings.Add(globalSetting);
        _context.SystemSettings.Add(companySetting);
        await _context.SaveChangesAsync();

        var globalRetrieved = await _context.SystemSettings
            .FirstOrDefaultAsync(x => x.SettingKey == "default_currency" && x.CompanyId == null);
        var companyRetrieved = await _context.SystemSettings
            .FirstOrDefaultAsync(x => x.SettingKey == "work_hours_per_day" && x.CompanyId == 1);

        // Assert
        Assert.NotNull(globalRetrieved);
        Assert.Equal("USD", globalRetrieved.SettingValue);
        Assert.Null(globalRetrieved.CompanyId);

        Assert.NotNull(companyRetrieved);
        Assert.Equal("8", companyRetrieved.SettingValue);
        Assert.Equal(1, companyRetrieved.CompanyId);
    }

    #endregion

