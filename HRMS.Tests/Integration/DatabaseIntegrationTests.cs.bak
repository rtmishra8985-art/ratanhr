            Relationship = "Spouse",
            Phone = "+1-555-0123",
            Email = "jane@example.com",
            Address = "123 Main St, City",
            Priority = 1,
            CreatedAt = DateTime.UtcNow
        };

        // Act
        _context.EmergencyContacts.Add(contact);
        await _context.SaveChangesAsync();

        var retrieved = await _context.EmergencyContacts
            .FirstOrDefaultAsync(x => x.ContactName == "Jane Doe");

        // Assert
        Assert.NotNull(retrieved);
        Assert.Equal(1, retrieved.Priority);
        Assert.Equal("Spouse", retrieved.Relationship);
        Assert.Equal("+1-555-0123", retrieved.Phone);
    }

    [Fact]
    public async Task SalaryStructureComponent_CanStoreFormula()
    {
        // Arrange
        var component = new SalaryStructureComponent
        {
            CompanyId = 1,
            SalaryStructureId = 1,
            ComponentType = "HRA",
            ComponentName = "House Rent Allowance",
            ComponentValue = null,
            ValueType = "Formula",
            FormulaExpression = "BasicSalary * 0.4",
            IsActive = true,
            DisplayOrder = 2,
            CreatedAt = DateTime.UtcNow
        };

        // Act
        _context.SalaryStructureComponents.Add(component);
        await _context.SaveChangesAsync();

        var retrieved = await _context.SalaryStructureComponents
            .FirstOrDefaultAsync(x => x.ComponentType == "HRA");

        // Assert
        Assert.NotNull(retrieved);
        Assert.Equal("Formula", retrieved.ValueType);
        Assert.Equal("BasicSalary * 0.4", retrieved.FormulaExpression);
        Assert.Equal(2, retrieved.DisplayOrder);
    }

