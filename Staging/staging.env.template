# =============================================================================
# Staging/staging.env.template — RatanHR HRMS Staging Secrets Template
#
# USAGE:
#   cp Staging/staging.env.template Staging/.env.staging
#   chmod 600 Staging/.env.staging
#   # Replace every <REPLACE_...> value with staging-only values
#   # Run:  bash Staging/bootstrap-staging.sh
#
# RULES:
#   • NEVER share credentials between staging and production
#   • NEVER commit Staging/.env.staging to version control
#     (it is listed in .gitignore — verify before committing)
#   • Generate RSA keys with:  bash scripts/generate-rsa-keys.sh
#   • Generate encryption key: openssl rand -base64 32
#   • Generate passwords:      openssl rand -base64 24
#
# This file documents EVERY variable consumed by:
#   Staging/docker-compose.staging.yml
#   Staging/phase8_runbook.sh
#   Staging/bootstrap-staging.sh
# =============================================================================

# ── MySQL ─────────────────────────────────────────────────────────────────────
# Root password for the staging MySQL container (needed by the seed step).
STAGING_DB_ROOT_PASSWORD=<REPLACE_WITH_STRONG_ROOT_PASSWORD>

# Application database name / user / password.
STAGING_DB_NAME=hrms_staging
STAGING_DB_USER=hrms_staging
STAGING_DB_PASSWORD=<REPLACE_WITH_STRONG_DB_PASSWORD>

# ── Redis ─────────────────────────────────────────────────────────────────────
STAGING_REDIS_PASSWORD=<REPLACE_WITH_STRONG_REDIS_PASSWORD>

# ── JWT RS256 key pair ────────────────────────────────────────────────────────
# Generate a staging-only pair (NEVER reuse production keys):
#   openssl genrsa -out /tmp/stg_rsa.pem 2048
#   openssl rsa -in /tmp/stg_rsa.pem -pubout -out /tmp/stg_rsa_pub.pem
#   # Paste the content of each file below, with \n replacing real newlines:
#   awk 'NF {printf "%s\\n", $0}' /tmp/stg_rsa.pem
#   awk 'NF {printf "%s\\n", $0}' /tmp/stg_rsa_pub.pem
#
# Alternative: bash scripts/generate-rsa-keys.sh  (targets .env, not this file)
JWT_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n<REPLACE_WITH_STAGING_PRIVATE_KEY_PEM>\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\n<REPLACE_WITH_STAGING_PUBLIC_KEY_PEM>\n-----END PUBLIC KEY-----"

# ── PII encryption ────────────────────────────────────────────────────────────
# 32 random bytes, base64-encoded. NEVER reuse the production key.
#   openssl rand -base64 32
ENCRYPTION_KEY_STAGING=<REPLACE_WITH_32_BYTE_BASE64_KEY>

# ── Superadmin seed account ────────────────────────────────────────────────────
# Used by phase8_runbook.sh to log in as superadmin on first run.
# The API seeds this account on first startup if it does not already exist.
# Force-change on first login is enforced (MustChangePassword=true).
SUPERADMIN_INITIAL_PASSWORD=<REPLACE_WITH_STAGING_SUPERADMIN_PASSWORD>

# ── Host/CORS ─────────────────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost;127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3001

# ── Compliance ────────────────────────────────────────────────────────────────
# Required by the API at startup. Staging-only contact details are fine here.
COMPLIANCE_DPO_EMAIL=dpo@hrms-staging.local
COMPLIANCE_REGIME=dpdp

# ── Email (MailHog — no external SMTP needed) ─────────────────────────────────
# MailHog is bundled in the staging stack. All outbound email is captured in
# the MailHog web UI at http://127.0.0.1:8025. No credentials required.
# Leave these values as-is unless you are testing against a real SMTP relay.
EMAIL_HOST=hrms_staging_mailhog
EMAIL_PORT=1025
EMAIL_FROM_ADDRESS=noreply@hrms-staging.local
APP_BASE_URL=http://localhost:3001
APP_SUPPORT_EMAIL=support@hrms-staging.local

# ── Biometric feature flags ────────────────────────────────────────────────────
# Realtime biometric monitoring is DEFERRED (see Biometric/BIOMETRIC_RELEASE_DECISION.md).
# Set to "false" to return HTTP 501 from GET /api/biometric/realtime (intended).
# Set to "true" only when the Realtime SDK integration is complete and signed off.
Features__BiometricRealtime=false

# ── Payroll defaults ──────────────────────────────────────────────────────────
PAYROLL_DEFAULT_STATE=Other

# ── Swagger UI protection ─────────────────────────────────────────────────────
# Swagger is enabled in Staging for debugging. Protect with credentials.
SWAGGER_USERNAME=staging-swagger
SWAGGER_PASSWORD=<REPLACE_WITH_SWAGGER_PASSWORD>

# ── Observability (optional in staging) ───────────────────────────────────────
# Leave empty to disable remote log shipping. Seq is free for single-user.
SEQ_URL=

# ── Build metadata (optional) ─────────────────────────────────────────────────
BUILD_TIMESTAMP=
GIT_SHA=
